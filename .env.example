# Copy to .env (Bun loads it automatically). Everything is optional,
# except the API key for whatever LLM your agent uses (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY).
# .env is gitignored: never commit keys.

# --- Agent (Gemini) ---
GEMINI_API_KEY=                   # required by `bun agent`; get one at Google AI Studio
# GEMINI_MODEL=                   # optional, defaults to gemini-3.5-flash (leave commented: an empty value would override the default)

# --- Global chaos ---
# CHAOS=off             # disables latency, errors and timeouts on every provider
# CHAOS_SEED=trama      # makes chaos deterministic (same requests => same outcomes)
# CATALOG_SEED=trama-2026
# LOG=off               # silence per-request provider logs

# --- Ports ---
# API_PORT=3000
# PROVIDER_A_PORT=4001
# PROVIDER_B_PORT=4002
# PROVIDER_C_PORT=4003

# --- Provider A: Andes Wholesale ---
# PROVIDER_A_LATENCY_MS=150-400
# PROVIDER_A_ERROR_RATE=0.03

# --- Provider B: SurBeds ---
# PROVIDER_B_LATENCY_MS=800-2500
# PROVIDER_B_TIMEOUT_RATE=0.05

# --- Provider C: LegacyGDS ---
# PROVIDER_C_LATENCY_MS=300-3000
# PROVIDER_C_ERROR_RATE=0.02
# PROVIDER_C_RATE_LIMIT_RPS=5     # 0 disables the rate limit

